# Byte-compiled / test-run artifacts: generated by running the suite, never part of the package,
# so a real test run cannot turn them into out-of-scope audit findings.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
.DS_Store
# Evidence archives stay outside the repository; no raw run logs are imported here.
